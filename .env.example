# =============================================================================
# Diamora Properties — Production Environment Variables
# =============================================================================

# Production Domain or Server IP (e.g. diamora.properties or 157.180.26.64)
# You can provide multiple domains separated by comma/space: diamora.properties, www.diamora.properties
DOMAIN=157.180.26.64

# ACME Email for automatic Let's Encrypt / ZeroSSL TLS certificate notifications
ACME_EMAIL=info@diamora.properties

# Database Configuration
MONGO_DB=diamora
MONGO_URI=mongodb://mongodb:27017/diamora

# Security & Secrets (Change in production!)
JWT_SECRET=diamora_super_secure_jwt_secret_key_prod_2026

# Automatic Database Seeding on first launch (true / false)
AUTO_SEED=true
