# =============================================================================
# Diamora Properties — Production Environment Variables
# =============================================================================

# Exposed Web Port (default: 80, change to 8080 or 443 if behind host proxy)
WEB_PORT=80

# Database Configuration
MONGO_DB=diamora
MONGO_URI=mongodb://mongodb:27017/diamora

# Security & Secrets (Change in production!)
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Automatic Database Seeding on first launch (true / false)
AUTO_SEED=true
